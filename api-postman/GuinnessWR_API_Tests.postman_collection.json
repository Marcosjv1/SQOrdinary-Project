                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-SM-02: status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('API-SM-02: response has token and username', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.expect(body.username).to.eql(pm.collectionVariables.get('dynUsername'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-SM-03: Get all records (Smoke)",
          "request": {
            "method": "GET",
            "header": [],
