{
  "info": {
    "_postman_id": "4135b731-6a12-4520-a48d-e838c007b18e",
    "name": "GuinnessWR API Tests - SQ Ordinary Project",
    "description": "API test suite for the GuinnessWR backend (SUT for the Software Quality Ordinary Project). 5 Smoke + 19 Regression cases covering all 6 POISED areas (Parameters, Output, Interoperability, Security, Errors, Data). Run against the live deployed backend (https://backendguinnesswr.onrender.com/api). Running this collection creates a handful of real records/users in the live database; cleanup requests are included where possible.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Smoke",
      "item": [
        {
          "name": "API-SM-01: Register new user (Smoke)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a brand new user. Username is made unique per run so it never collides with a previous run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{dynUsername}}\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('dynUsername', 'smoke_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-SM-01: status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('API-SM-01: response has token and username', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('token');",
                  "  pm.expect(body).to.have.property('username');",
                  "});",
                  "pm.collectionVariables.set('registeredPassword', 'secret123');",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('authToken', pm.response.json().token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "API-SM-02: Login with valid credentials (Smoke)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
