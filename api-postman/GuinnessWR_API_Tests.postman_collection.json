                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.iterationData.get('username');",
                  "if (u && u.length >= 3) { pm.variables.set('username', u + '_' + Date.now()); }",
                  "else { pm.variables.set('username', u); }",
                  "pm.variables.set('password', pm.iterationData.get('password'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = parseInt(pm.iterationData.get('expectedStatus'));",
                  "pm.test('DD row (' + pm.iterationData.get('note') + '): status is ' + expected, () => {",
                  "  pm.response.to.have.status(expected);",
                  "});"
                ]
              }
            }
          ]
        }
