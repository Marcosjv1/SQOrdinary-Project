          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-RG-15: SECURITY FINDING if 200 - delete endpoint has no auth check', () => {",
                  "  if (pm.response.code === 200) { console.warn('SECURITY FINDING: DELETE /records/:id succeeded with no Authorization header'); }",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 404]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-RG-16: Login - NoSQL injection attempt is not authenticated",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Sends Mongo operator objects instead of strings. The important assertion is that this never returns 200/token; the exact status (400 vs 500) is noted as a secondary robustness finding.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": {\n    \"$ne\": null\n  },\n  \"password\": {\n    \"$ne\": null\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-RG-16 (Security): injection payload does not return a token', () => {",
                  "  pm.expect(pm.response.code).to.not.eql(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "isOficial protection rule, and the known missing-auth-middleware finding on write routes."
    },
